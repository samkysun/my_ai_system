import streamlit as st
import pandas as pd
import hashlib
import time

st.set_page_config(page_title="智能系统", page_icon="🧊", layout="wide")

# 初始化状态
if "logged_in" not in st.session_state:
    st.session_state.logged_in = False
if "username" not in st.session_state:
    st.session_state.username = ""

# ★ 核心：连接到云端数据库
conn = st.connection("supabase", type="sql")

# 密码加密（客户密码在数据库里是乱码，非常安全）
def hash_password(password):
    return hashlib.sha256(password.encode()).hexdigest()

# ==========================================
# 1. 客户注册与登录界面
# ==========================================
def login_page():
    st.title("🔐 智能系统客户端登录")
    
    tab1, tab2 = st.tabs(["已有账号？登录", "没有账号？立即注册"])
    
    # 登录
    with tab1:
        login_user = st.text_input("用户名", key="login_user")
        login_pass = st.text_input("密码", type="password", key="login_pass")
        if st.button("登录", use_container_width=True):
            if login_user and login_pass:
                hashed = hash_password(login_pass)
                # 去云端查询是否存在该用户
                try:
                    with conn.session as s:
                        result = s.execute(
                            "SELECT username FROM users WHERE username = :u AND password = :p",
                            params={"u": login_user, "p": hashed}
                        ).fetchone()
                    
                    if result:
                        st.session_state.logged_in = True
                        st.session_state.username = login_user
                        st.success("登录成功！正在进入系统...")
                        time.sleep(1)
                        st.rerun()
                    else:
                        st.error("用户名或密码错误！请检查或重新注册。")
                except Exception as e:
                    st.error(f"数据库连接出错: {e}")
            else:
                st.warning("请输入用户名和密码")
                
    # 注册
    with tab2:
        reg_user = st.text_input("设置用户名", key="reg_user")
        reg_pass = st.text_input("设置密码", type="password", key="reg_pass")
        reg_confirm = st.text_input("确认密码", type="password", key="reg_confirm")
        if st.button("注册账号", use_container_width=True):
            if reg_user and reg_pass:
                if reg_pass != reg_confirm:
                    st.error("两次输入的密码不一致")
                else:
                    hashed = hash_password(reg_pass)
                    try:
                        with conn.session as s:
                            # 将新用户插入云端数据库
                            s.execute(
                                "INSERT INTO users (username, password) VALUES (:u, :p)",
                                params={"u": reg_user, "p": hashed}
                            )
                            s.commit()
                        st.success("🎉 注册成功！请点击左侧【登录】标签页进行登录。")
                    except Exception as e:
                        if "unique constraint" in str(e):
                            st.error("该用户名已被别人注册，请换一个名字！")
                        else:
                            st.error(f"注册失败: {e}")
            else:
                st.warning("请填写完整信息")

# ==========================================
# 2. 系统主界面（只有登录成功才能看到）
# ==========================================
def main_app():
    with st.sidebar:
        st.write(f"👤 当前登录客户: **{st.session_state.username}**")
        if st.button("退出登录", use_container_width=True):
            st.session_state.logged_in = False
            st.session_state.username = ""
            st.rerun()
        st.divider()
        page = st.radio("导航菜单", ["🏠 主界面", "🤖 分析系统"])
        st.divider()

    if page == "🏠 主界面":
        st.title("🧊 欢迎使用客户端系统")
        st.write(f"你好，{st.session_state.username}！")
        st.success("你已成功登录。由于连接了云端数据库，下次你再打开网页，直接用相同的账号密码就能登录。")

    elif page == "🤖 分析系统":
        st.title("🤖 分析系统模块")
        st.write("这里是你真正的计算逻辑代码...")

# ==========================================
# 3. 大门控制
# ==========================================
if not st.session_state.logged_in:
    login_page()
else:
    main_app()
